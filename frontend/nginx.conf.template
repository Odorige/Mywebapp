server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # ============================================================
    # FRONTEND
    # ============================================================
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ============================================================
    # BACKEND API
    # ============================================================
    #
    # BACKEND_URL_PLACEHOLDER and BACKEND_HOST_PLACEHOLDER are
    # substituted at container startup by
    # /docker-entrypoint-streamhive.sh based on the BACKEND_URL
    # environment variable.
    #
    # Local Docker Compose:
    #     BACKEND_URL=http://backend:4000
    #     -> proxies to the local backend container.
    #
    # Azure:
    #     BACKEND_URL is not set by the pipeline, so the
    #     entrypoint script falls back to the production
    #     Azure Container Apps backend URL automatically.
    #     Set BACKEND_URL explicitly on the frontend Container
    #     App if you ever need to point it elsewhere.
    # ============================================================
    location /api/ {

        proxy_pass BACKEND_URL_PLACEHOLDER/api/;

        # --------------------------------------------------------
        # HTTPS / TLS configuration
        # --------------------------------------------------------
        # These directives are only applied by Nginx when
        # BACKEND_URL_PLACEHOLDER resolves to an https:// upstream
        # (i.e. Azure). They are harmless no-ops when proxying to
        # a plain http backend (i.e. local Docker).
        proxy_ssl_server_name on;
        proxy_ssl_name BACKEND_HOST_PLACEHOLDER;

        # --------------------------------------------------------
        # HTTP proxy configuration
        # --------------------------------------------------------
        proxy_http_version 1.1;

        # IMPORTANT:
        # Send the backend hostname, NOT the frontend hostname.
        proxy_set_header Host BACKEND_HOST_PLACEHOLDER;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # --------------------------------------------------------
        # Request / response settings
        # --------------------------------------------------------
        proxy_buffering off;

        client_max_body_size 500M;

        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # ============================================================
    # GZIP
    # ============================================================
    gzip on;

    gzip_types
        text/css
        application/javascript
        application/json
        text/plain
        application/xml
        application/xml+rss
        text/javascript;
}
